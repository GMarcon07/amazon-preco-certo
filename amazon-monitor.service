[Unit]
Description=Amazon Price Glitch Monitor (Gaming & Tech)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Amazon_Preco_Certo
ExecStart=/usr/bin/python3 run.py --daemon
Restart=always
RestartSec=15
StandardOutput=append:/opt/Amazon_Preco_Certo/data/monitor.log
StandardError=append:/opt/Amazon_Preco_Certo/data/monitor.log

[Install]
WantedBy=multi-user.target
